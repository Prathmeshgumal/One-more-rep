<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 8 and up masks a launcher icon to whatever shape the launcher wants,
  so it takes two layers rather than one flat square. The legacy PNGs are still
  there, and still used, because minSdkVersion is 24.

  The background is the flat colour the artwork sits on; the foreground is the
  mark lifted off it, drawn inside the safe zone so a circular or squircle mask
  cannot clip it. Both are generated by scripts/build-icons.ps1.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
