{
  "name": "OneMoreRep",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "set NoDefaultCurrentDirectoryInExePath=&& react-native run-android",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx,.mjs src __tests__ scripts",
    "android:release": "set NoDefaultCurrentDirectoryInExePath=&& react-native run-android --mode release",
    "android:fast": "set NoDefaultCurrentDirectoryInExePath=&& react-native run-android --no-packager",
    "apk": "cd android && gradlew.bat assembleRelease",
    "fonts": "python scripts/build-fonts.py",
    "db:generate": "drizzle-kit generate && node scripts/build-migrations.mjs",
    "seed:fetch": "node scripts/fetch-exercise-source.mjs",
    "seed:build": "node scripts/build-exercise-seed.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^18.1.4",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "@tanstack/react-query": "^5.101.4",
    "drizzle-orm": "^0.45.2",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-reanimated": "^4.6.0",
    "react-native-reorderable-list": "^0.18.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.27.0",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "^0.12.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
